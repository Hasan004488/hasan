{
  "name": "eitix",
  "version": "2.8.5",
  "description": "Client Dashboard for EITIx Web App. Eaglesidea Thread Intelligence Project.",
  "main": "EITIx.js",
  "scripts": {
    "client": "pm2 start system.config.js && pm2 save",
    "dev": "pm2 start system.config.js --env development --watch",
    "stop": "pm2 stop system.config.js",
    "restart": "pm2 restart system.config.js",
    "monitor": "pm2 monit",
    "logs": "pm2 logs",
    "shutdown": "pm2 stop all",
    "reload": "pm2 reload all",
    "delete": "pm2 delete all",
    "startup": "pm2 startup systemd",
    "flush": "pm2 flush-cache",
    "update": "pm2 update",
    "list": "pm2 list",
    "backup": "node 'libraries/backup-eitix'",
    "patch": "node 'libraries/patch/patch'",
    "reset": "node 'libraries/reset'",
    "analyze": "node 'libraries/analyze-db'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIR360/EITIx--Dashboard.git"
  },
