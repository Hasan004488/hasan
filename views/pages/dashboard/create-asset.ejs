<link rel="stylesheet" href="/styles/progress-steps.css">
<link rel="stylesheet" href="/styles/select2.css">

<!-- Circles which indicates the steps of the form: -->
<div id="step-indicator" class="d-flex gap-2 justify-content-center align-items-center mt-4 mb-2">
  <span class="step">1</span>
  <span class="step">2</span>
  <span class="step">3</span>
</div>

<form class="col-lg-7 user-selection-form-wrapper" id="create-asset" 
  action="/dashboard/assets/create" method="POST">

  <!-- Basic Information -->
  <div class="tab p-4 bg-white rounded shadow mb-3">

    <div class="mb-3 fw-bold d-flex align-items-center justify-content-between">
        <div class="fs-4 fw-bold">Basic Information</div>
        <div class="small">By: <strong class="text-primary">
            <%= locals.email %>
        </strong></div>
    </div>

    <div class="d-flex gap-2">
      <%- include("../components/form/input-box.ejs", {
        label: "Asset name",
        name: "name",
        value: data.name || data.host,
        placeholder: "Asset or service name",
        char_limit: [1, 255],
        required: true
      }) %>
      <%- include("../components/form/select-box.ejs", {
        label: "Category",
        name: "category",
        required: true,
        selected: data.category || "server",
        options: [
          {
            value: "server",
            option: "Server"
          },
          {
            value: "router",
            option: "Router"
          },
          {
            value: "switch",
            option: "Switch"
          },
          {
            value: "firewall",
            option: "Firewall"
          },
        ]
      }) %>
    </div>

    <div class="d-flex gap-2">
      <%- include("../../components/form/select-box.ejs", {
        id: "connection-selection",
        label: "Connection",
        name: "connection",
        selected: data.connection || "tcp",
        required: true,
        event: "onchange=changeConnection(this)",
        options: [
          {
            value: "tcp",
            option: "TCP"
          },
          {
            value: "icmp",
            option: "ICMP (Ping)"
          },
          {
            value: "snmpv3",
            option: "SNMPv3"
          }
        ]
      }) %>
      <%- include("../components/form/select-box.ejs", {
        label: "Operating System",
        name: "os",
        required: true,
        options: [
          {
            value: "linux",
            option: "Linux"
          },
          {
            value: "windows",
            option: "Windows"
          },
          {
            value: "freebsd",
            option: "FreeBSD"
          }
        ]
      }) %>
    </div>

    <div class="d-flex gap-2">
      <%- include("../components/form/select-box.ejs", {
        label: "Location",
        name: "location",
        required: true,
        selected: data.location || "on-prem",
        options: [
          {
            value: "on-prem",
            option: "On Premises"
          },
          {
            value: "remote",
            option: "Remote"
          },
          {
            value: "hybrid",
            option: "Hybrid"
          },
        ]
      }) %>
    <%- include("../components/form/select-box.ejs", {
        label: "Visibility",
        name: "visibility",
        required:true,
        selected: data.visibility || "local",
        options: [
          {
            value: "local",
            option: "Local"
          },
          {
            value: "cloud",
            option: "Cloud"
          },
          {
            value: "both",
            option: "Both"
          }
        ]
      }) %>

    <%- include("../components/form/select-box.ejs", {
        label: "Tracking",
        name: "tracking",
        required:true,
        selected: data.tracking || "on",
        options: [
          {
            value: "on",
            option: "ON"
          },
          {
            value: "off",
            option: "OFF"
          }
          
        ]
      }) %>
    </div>

  </div>

  <!-- Asset Configurations -->
  <div class="tab p-4 bg-white rounded shadow mb-3">

    <div class="fs-4 fw-bold mb-3">Asset Configuration</div>

    <div id="asset-connections">

      <div id="connection-tcp-options">
        <div class="d-flex gap-2">
          <%- include("../components/form/input-box.ejs", {
            label: "IP Address",
            name: "ip",
            value: data.ip,
            placeholder: "ex: 8.8.8.8",
            char_limit: [1, 50],
            required: true,
            extra: "pattern=^((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])$"
          }) %>
    
        <%- include("../components/form/input-box.ejs", {
            label: "TCP Port",
            name: "port",
            value: data.port,
            placeholder: "ex: 8080",
            type: "number",
            num_limit: [0, 70000],
            required: true
          }) %>
    
        <%- include("../components/form/input-box.ejs", {
            label: "Timeout (In ms)",
            type: "number",
            name: "timeout",
            value: data.timeout || 5000,
            placeholder: "ex: 5000",
            num_limit: [1, 30000],
            required: true
        }) %>
        </div>
      </div>
  
      <div id="connection-icmp-options" class="d-none">
        <div class="d-flex gap-2">
          <%- include("../components/form/input-box.ejs", {
            label: "IP or Domain",
            name: "ip",
            value: data.ip,
            placeholder: "ex: 8.8.8.8, google.com",
            char_limit: [1, 255],
            required: true,
          }) %>
          <%- include("../components/form/input-box.ejs", {
              label: "Timeout (In ms)",
              type: "number",
              name: "timeout",
              value: data.timeout || 5000,
              placeholder: "ex: 5000",
              num_limit: [1, 30000],
              required: true
          }) %>
        </div>
      </div>
  
      <div id="connection-snmpv3-options" class="d-none">

        <div class="d-flex gap-2">
          <%- include("../components/form/input-box.ejs", {
            label: "IP or Domain",
            name: "ip",
            value: data.ip,
            placeholder: "ex: 8.8.8.8",
            char_limit: [1, 50],
            required: true,
          }) %>
          <%- include("../components/form/input-box.ejs", {
            label: "SNMP Port",
            name: "port",
            value: data.port || 161,
            placeholder: "ex: 161",
            type: "number",
            num_limit: [0, 65535],
            required: true
          }) %>
    
          <%- include("../components/form/input-box.ejs", {
            label: "Timeout (In seconds)",
            type: "number",
            name: "timeout",
            value: data.timeout || 5000,
            placeholder: "ex: 5000",
            num_limit: [1, 30000],
            required: true
          }) %>
        </div>

        <div class="d-flex gap-2">
          <%- include("../components/form/select-box.ejs", {
            id: "snmpv3-security-level",
            label: "Security Level",
            name: "security_level",
            selected: data.security_level || "3",
            event: "onchange=snmpv3Options(this)",
            options: [
              {
                value: "1",
                option: "No Auth. / No Privacy"
              },
              {
                value: "2",
                option: "Auth. / No Privacy"
              },
              {
                value: "3",
                option: "Auth. / Privacy"
              }
            ],
            required: true,
          }) %>
          <%- include("../components/form/select-box.ejs", {
            id: "snmpv3-auth-protocol",
            label: "Auth. Protocol",
            name: "auth_protocol",
            selected: data.auth_protocol || "3",
            options: [
              {
                value: "2",
                option: "MD5"
              },
              {
                value: "3",
                option: "SHA"
              }
            ],
            required: true,
          }) %>
          <%- include("../components/form/select-box.ejs", {
            id: "snmpv3-priv-protocol",
            label: "Privacy Protocol",
            name: "priv_protocol",
            selected: data.priv_protocol || "4",
            options: [
              {
                value: "4",
                option: "AES"
              },
              {
                value: "2",
                option: "DES"
              }
            ],
            required: true,
          }) %>
        </div>

        <div class="d-flex gap-2">
          <%- include("../components/form/input-box.ejs", {
            id: "snmpv3-security-name",
            label: "Security Name",
            name: "security_name",
            value: data.security_name,
            char_limit: [1, 255],
            required: true
          }) %>
          <%- include("../components/form/input-box.ejs", {
            id: "snmpv3-auth-password",
            label: "Auth. Password",
            name: "auth_password",
            value: data.auth_password,
            char_limit: [1, 255],
            required: true
          }) %>
          <%- include("../components/form/input-box.ejs", {
            id: "snmpv3-priv-password",
            label: "Privacy Password",
            name: "priv_password",
            value: data.priv_password,
            char_limit: [1, 255],
            required: true,
          }) %>
        </div>
  
      </div>
  
    </div>

  </div>

  <!-- Confirm Selection -->
  <div class="tab p-4 py-5 bg-white rounded-pill shadow mb-3 text-center scale-in-center">

    <div class="display-3">
      <i class="fa-regular fa-circle-question"></i>
    </div>
    <h5 class="fs-5 fw-bold">
      Are you ready to submit?
    </h5>

    <div class="">
      <% if (data.name) { %>
        Please press submit if you want to update.
      <% } else { %>
        Please press submit if you want to create.
      <% } %>
    </div>
      
  </div>

  <div class="text-end mt-4">
    <button class="btn btn-secondary rounded-pill px-4 me-2" type="button" id="prevBtn" onclick="nextPrev(-1)">
      <i class="fa fa-arrow-left"></i>
      Previous
    </button>
    <button class="btn btn-success rounded-pill px-4" type="button" id="nextBtn" onclick="toggleSection('#progress-next-loading-icon'); nextPrev(1)">
      Next
      <i class="fa fa-arrow-right"></i>
    </button>
  </div>

  <!-- hidden fields -->
  <div class="d-none">
    <input name="recipients" type="text">
    <input id="uba-type-input" name="uba_type" type="text" value="<%= data.uba_type || "activity" %>">
    <% if (data._id) { %>
      <input name="id" type="text" value="<%= data._id %>">
      <input name="updating" type="text" value="true">
    <% } %>
  </div>

  <div class="py-5"></div>

</form>

<%- include('./user-selection') %>

<script>
  window.eitix_progress_form_target = "#create-asset";
</script>

<script src="/scripts/progress-steps.js"></script>
<script src="/scripts/select2.js"></script>

<script>

  let form_submission_fired = false;

  let mode = "<%= data._id ? 'update' : 'create' %>";

  // custom validator
  customValidator = (callback) => {

    // This function deals with validation of the form fields
    let x, y, i, valid = true;
    let form = document.querySelector(window.eitix_progress_form_target);

    changeConnection({ value: form['connection'].value });
    if (form['connection'].value == "snmpv3") {
      snmpv3Options({ value: form['security_level'].value });
    }

    if (currentTab === 0) {

      // basic info
      if (mode === 'create') {

        // both for ai asset and wazuh asset
        let name = form["name"].value;

        fetchDynamicData({
          url: `/content/check/value?col=assets&field=name&val=${name}`
        }, (response) => {

          if (response?.unique) {

            return callback(true);

          } else {

            toast("Asset already exists", "Please set another unique name", 1);
            return callback(false);

          }

        })

        } else {

        return callback(true);

      }

    } else if (currentTab === 2) {

      form_submission_fired = true;
      return callback(true);

    } else {

      form_submission_fired = false;
      return callback(true);

    }

  }

  function changeConnection(selectbox) {

    let selected = selectbox.value;
    let selected_connection_options = document.getElementById(`connection-${selected}-options`);
    let all_connection_options = document.getElementById("asset-connections");

    Array.from(all_connection_options.children).forEach(el => el.classList.add("d-none"));
    selected_connection_options.classList.remove("d-none");

    Array.from(all_connection_options.querySelectorAll("input, select")).forEach(el => el.disabled = true);
    Array.from(selected_connection_options.querySelectorAll("input, select")).forEach(el => el.disabled = false);

  }

  function snmpv3Options(selector) {

    let selected = selector.value;
    
    let auth_password = document.getElementById("snmpv3-auth-password");
    let auth_protocol = document.getElementById("snmpv3-auth-protocol");
    let priv_password = document.getElementById("snmpv3-priv-password");
    let priv_protocol = document.getElementById("snmpv3-priv-protocol");
    let security_name = document.getElementById("snmpv3-security-name");

    if (selected === "1") {
      auth_password.disabled = true;
      auth_protocol.disabled = true;
      priv_password.disabled = true;
      priv_protocol.disabled = true;
      security_name.disabled = true;
    } else if (selected === "2") {
      auth_password.disabled = false;
      auth_protocol.disabled = false;
      priv_password.disabled = true;
      priv_protocol.disabled = true;
      security_name.disabled = false;
    } else if (selected === "3") {
      auth_password.disabled = false;
      auth_protocol.disabled = false;
      priv_password.disabled = false;
      priv_protocol.disabled = false;
      security_name.disabled = false;
    }

  }
  
  window.addEventListener('beforeunload', function (e) {

    if (!form_submission_fired) {
        e.preventDefault();
    }

  });

</script>