<div class="col-12">
  <div class="p-4 bg-white rounded shadow">

    <div class="d-flex align-items-center justify-content-between">
      <h4 class="fw-bold">
        Cloud Assets for Monitoring
      </h4>
      <div class="d-flex gap-2">
        <% if (access("createAsset", locals.permissions)) { %>
          <a href="/dashboard/assets/create#Assets" class="btn rounded-pill btn-primary px-3 toggler" type="button">
            <i class="fa fa-add"></i>
            Add New Asset
          </a>
        <% } %>
        <%- include('components/search-control-buttons') %>
      </div>
    </div>

    <%- include("components/body/search-data.ejs", {
      options: [
        { name: "Name", property: "name" },
        { name: "Asset ID", property: "sid" },
        { name: "Host Address", property: "ip" },
        { name: "Port", property: "port" },
        { name: "OS", property: "os" },
        { name: "Location", property: "location" },
        { name: "Type", property: "type" },
        { name: "Visibility", property: "visibility" }
      ],
      total_text: "Total cloud assets:"
    }) %>

    <%- include("components/body/data-table.ejs") %>

  </div>
</div>

