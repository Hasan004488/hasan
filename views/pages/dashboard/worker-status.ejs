<% for(const name in workers) { %>
<% let worker =  workers[name]; %>
<div class="col-md-4">
  <div class="worker-card p-3 <%= worker?.running ? "running" : "" %>">
    <div class="d-flex align-items-center gap-1">
      <div>
        <img src="/images/worker-logo-gear.png" alt="worker avatar" height="50">
      </div>
      <div>
        <strong class="fs-5 mb-0"><%= locals.format.title(name) %></strong> <br>
        <% if (worker?.running) { %>
        <small class="fw-bold text-primary">
          <i class="fas fa-gear fa-spin"></i>
          Running
        </small>
        <% } else { %>
        <small class="fw-bold">
          <i class="fas fa-bed"></i>
          Sleeping
        </small>
        <% } %>
      </div>
      <div class="ms-auto">
        <% if (worker.active) { %>

        <a href="/dashboard/settings/worker/control?name=<%= name %>&option=stop" type="button" class="toggle-btn bg-success" onclick="return confirmChoice(event, 'Are you sure to stop this worker? EITIx may not work properly.')" title="Working is active">
          Active
          <span class="bg-white inline-circle"></span>
        </a>

        <% } else { %>

        <a href="/dashboard/settings/worker/control?name=<%= name %>&option=start" type="button" class="toggle-btn bg-danger" title="Working is in-active">
          <span class="bg-white inline-circle"></span>
          In-active
        </a>

        <% } %>
      </div>
    </div>

    <% if (worker?.running) { %>
    <div class="progress my-2" style="height: 10px;">
      <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%;"></div>
    </div>
    <% } else { %>
    <div class="progress my-2" style="height: 10px;">
      <div class="progress-bar progress-bar-striped bg-light" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%;"></div>
    </div>
    <% } %>

    <div class="d-flex flex-column flex-lg-row gap-3 justify-content-between">
      <div class="">
        <h5 class="fw-bold mb-0 text-success"><%= worker.rest || 0 %> Minute(s)</h5>
        <small>Sleep Time</small>
      </div>
      <div class="text-end">
        <h5 class="fw-bold mb-0 text-danger">~ <%= worker.execution || 0 %> Second(s)</h5>
        <small>Execution Time</small>
      </div>
    </div>

    <div class="py-1"></div>

    <div class="small p-2">
      <%- workers[name].info %>
    </div>

  </div>
</div>

<% } %>