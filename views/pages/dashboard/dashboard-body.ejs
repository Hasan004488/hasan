        <button class="btn btn-sm btn-tab-off px-3" onclick="changeEPS('1d')" title="Event Per Hour">
          <i class="fa fa-clock"></i>
          EPH
        </button>
        <button class="btn btn-sm btn-tab-off px-3" onclick="changeEPS('1w')" title="Event Per Day">
          <i class="fa fa-clock"></i>
