
<% 
const template = data;
const editing = data.title ? true : false;
%>

<link rel="stylesheet" type="text/css" href="/styles/quill.snow.css">
<script type="text/javascript" src="/scripts/quill.min.js"></script>
<link rel="stylesheet" href="/styles/template.css">


<form class="col-12 row gy-3" id="edit-template" action="/dashboard/templates/edit" method="POST">

  <div class="p-4 bg-white rounded shadow">

    <div class="row">
      
      <div class="col-md-8">
  
          <div class="fs-5 py-2">
              <strong>Email Ticket Template Editor</strong>
          </div>
  
          <div class="py-2">
  
              <div class="d-flex gap-3">
                <%- include("../../../components/form/input-box.ejs", {
                  label: "Template Name",
                  name: "title",
                  placeholder: "Add template name",
                  value: template.title , 
                  char_limit: [0, 255],
                  required: true
                }) %>
                <div class="form-group py-1 mb-2 w-100">
                  <div class="fw-bold text-primary mb-2">Ticket Action</div>
                  <select name="action" class="form-select w-100 rounded-pill fw-bold text-secondary" >
                    
                      <option value="ticket_created" <%= template.action === "ticket_created" ? "selected" : "" %>>Ticket Created</option>
                      <option value="ticket_closed" <%= template.action === "ticket_closed" ? "selected" : "" %>>Ticket Closed</option>
                      <option value="ticket_expired" <%= template.action === "ticket_expired" ? "selected" : "" %>>Ticket Expired</option>
                      
                  </select>
              </div>
              </div>
              
              <%- include("../../../components/form/input-box.ejs", {
                label: "Subject",
                name: "subject",
                placeholder: "Subject text for the email",
                value: template.subject ,
                char_limit: [1, 255],
                required: true
              }) %>

              <div class="form-group py-2">
                  <div class="mb-2 fw-bold text-primary">Section A (Ticket Header)</div>
                  <div id="section-a-editor" class="form-control"
                      style="font-size: inherit; min-height: 10vh;">
                      <%- template.section_a %>
                  </div>
              </div>
              <div class="form-group py-2">
                <div class="mb-2 fw-bold text-primary">Section B (Ticket Summary) - Automatically Populated</div>
                <div class="form-control p-4 area_blocked">
                  <%- template.summary %>
                </div>
            </div>
              <div class="form-group py-2">
                  <div class="mb-2 fw-bold text-primary">Section C (Ticket Footer)</div>
                  <div id="section-b-editor" class="form-control"
                      style="font-size: inherit; min-height: 10vh;">
                      <%- template.section_b %>
                  </div>
              </div>
              <div class="small my-2">
                <i class="fa fa-circle-info"></i>
                This is the redirect url of the button after summary
              </div>

              <div class="mt-3 d-flex gap-3">
                <button type="button" class="btn rounded-pill btn-secondary" onclick="submit_form('load'); togglePopup('Template Preview', copyContent('#preview-content'));">
                  <i class="fa fa-eye"></i> Load Preview
                </button>
                <% if (editing) { %>
            
                  <button type="button" class="btn rounded-pill btn-primary" onclick="submit_form('update');">
                    <i class="fa fa-arrow-up"></i>
                    Update Template
                  </button>
      
                <% } else { %>
      
                  <button type="button" class="btn rounded-pill btn-primary" onclick="submit_form('create');">
                    <i class="fa-solid fa-plus"></i>
                    Create New Template
                  </button>
      
                <% } %>
              </div>
  
          </div>
  
          <div id="preview-content" class="d-none">
            
            <div class="">
  
              <div>
                  <strong>Subject: </strong> 
                  <span id="load-subject"><%- template.subject %></span>
              </div>
              
              <hr>
  
              <div id="load-section-a"><%- template.section_a %></div>
              <div id="load-summary" class="area_blocked"><%- template.summary %></div>
              <div id="load-section-b"><%- template.section_b %></div>
              <div id="load-section-b"><%- template.footer %></div>
  
            </div>
  
          </div>
  
          <div class="d-none">
              <input type="text" name="id" value="<%= template._id %>">
              <input type="text" name="author" value="<%= locals.email %>">
              <input type="text" name="type" value="<%= template.type || "ticket" %>">
              <input type="text" name="summary" value="<%= template.summary %>">
              <input type="text" name="edit" value="">
              <input type="text" name="section_a" value="">
              <input type="text" name="section_b" value="">
              <input type="text" name="footer" value="">
          </div>
  
      </div>
  
      <div class="col-md border-start border-secondary sticky-top">
  
        <div class="fs-5 py-2">
          <strong>Template Placeholders</strong>
        </div>
  
        <div class="py-2">
          <details open>
            <summary class="fw-bold">${ticket_sid}</summary>
            <div class="small ms-3">Readable ID of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${ticket_level}</summary>
            <div class="small ms-3">Level of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${ticket_type}</summary>
            <div class="small ms-3">Incident/Support type of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${ticket_criticality}</summary>
            <div class="small ms-3">Low/Medium/High criticality of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${ticket_status}</summary>
            <div class="small ms-3">Open/closed/expire status of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${log_id}</summary>
            <div class="small ms-3">The Log ID from where the ticket was originated</div>
          </details>
          <details open>
            <summary class="fw-bold">${ticket_opening_date}</summary>
            <div class="small ms-3">Opening date of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${next_escalation_date}</summary>
            <div class="small ms-3">
              The next date this ticket will escalate to higher level
            </div>
          </details>
          <details open>
            <summary class="fw-bold">${expiry_date}</summary>
            <div class="small ms-3">Expiration date of the ticket</div>
          </details>
          <details open>
            <summary class="fw-bold">${closing_date}</summary>
            <div class="small ms-3">Closing date of the ticket</div>
          </details>
        </div>
  
      </div>

    </div>

  </div>

</form>


<script>

    let form_submission_fired = false;

    // make quill editors
    const section_a_editor = new Quill('#section-a-editor', QUILL_OPTIONS);
    const section_b_editor = new Quill('#section-b-editor', QUILL_OPTIONS);
    
    /**
     * Submit the template form.
     * 
     * If type is 'load', load the preview in the page.
     * If type is not 'load', check if the form is valid, and if it is, show a confirmation dialog.
     * If the user confirms, submit the form.
     * 
     * @param {string} type - 'load' or a string that is not 'load'
     */
    async function submit_form(type) {

        const form = document.getElementById("edit-template");

        form_submission_fired = true;

        if (type == 'load') {

            // load the preview
            $("#load-subject").text(form.subject.value);
            $("#load-section-a").html(section_a_editor.root.innerHTML);
            $("#load-section-b").html(section_b_editor.root.innerHTML);

        } else {

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          let confirm = await customConfirm("Are you sure to submit?");

          if (confirm) {

            form.section_a.value = section_a_editor.root.innerHTML;
            form.section_b.value = section_b_editor.root.innerHTML;

            form.edit.value = type;
            form.submit();

          }

        }
        
    }
    
    window.addEventListener('beforeunload', function (e) {

        if (!form_submission_fired) {
            e.preventDefault();
        }

    });


</script>