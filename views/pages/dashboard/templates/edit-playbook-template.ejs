
<% 
const template = data;
const editing = data.title ? true : false;
%>

<link rel="stylesheet" type="text/css" href="/styles/quill.snow.css">
<script type="text/javascript" src="/scripts/quill.min.js"></script>
<link rel="stylesheet" href="/styles/template.css">


<form class="col-12 row gy-3" id="edit-template" action="/dashboard/templates/edit" method="POST">

    <div class="p-4 bg-white rounded shadow">

      <div class="row gap-3">

        <div class="col-md-8">
            
          <div class="fs-5">
              <strong>Playbook Template Editor</strong>
          </div>

          <div class="py-2">

            <div class="d-flex gap-3">
              <%- include("../../../components/form/input-box.ejs", {
                label: "Template Rule ID",
                name: "rule",
                placeholder: "Add template rule ID",
                value: template.rule,
                required:true
                
              }) %>
  
              <%- include("../../../components/form/input-box.ejs", {
                label: "Template Title",
                name: "title",
                placeholder: "Add template name",
                value: template.title,
                required:true
                
              }) %>
            </div>

            <div class="py-2 mb-2 border-bottom">
              <strong>Email Section</strong>
            </div>

            <!-- <div class="input-group py-2">
                <span class="input-group-text">Email Subject</span>
                <input class="form-control" name="subject" maxlength="255" placeholder="If not set then template title will be used as subject">
            </div> -->
            <%- include("../../../components/form/input-box.ejs", {
              label: "Subject",
              name: "subject",
              placeholder: "If not set then template title will be used as subject",
              char_limit: [1, 255],
              value: template.subject,
            }) %>

            <div class="form-group py-2">
                <div class="mb-2 fw-bold text-primary">Body</div>
                <div id="body-editor" class="form-control"
                    style="font-size: inherit; min-height: 10vh;">
                    <%- template.body %>
                </div>
            </div>

            <div class="py-2 my-2 border-bottom">
              <strong>SMS Section</strong>
            </div>

            <div class="form-group py-2">
              <div class="mb-2 fw-bold text-primary">Text Message</div>
              <textarea name="sms_text" maxlength="500" rows="4" class="form-control" placeholder="Write SMS text here"><%= template.sms_text %></textarea>
            </div>

            <div class="mt-3 d-flex gap-3">
                <button type="button" class="btn rounded-pill btn-secondary" onclick="
                  submit_form('load');
                  togglePopup('Template Preview', copyContent('#preview-content'));
                ">
                  <i class="fa fa-eye"></i> Load Preview
                </button>
                <% if (editing) { %>
            
                  <button type="button" class="btn btn-primary rounded-pill px-3" onclick="submit_form('update');">
                    <i class="fa fa-arrow-up"></i>
                    Update Template
                  </button>
      
                <% } else { %>
      
                  <button type="button" class="btn rounded-pill btn-primary" onclick="submit_form('create');">
                   <i class="fa fa-plus"></i> 
                    Create New Template
                  </button>
      
                <% } %>
            </div>

        </div>

          <div id="preview-content" class="d-none">
                                  
              <div class="mail-container w-half py-3">
                  
                  <div id="load-body"><%- template.body %></div>
                  <div id="load-footer"><%- template.footer %></div>

              </div>

          </div>

          <div class="d-none">
            <input type="text" name="id" value="<%= template._id %>">
            <input type="text" name="type" value="<%= template.type || type %>">
            <input type="text" name="body" value="">
            <input type="text" name="edit" value="">
          </div>

      </div>

      <div class="col-md border-start border-secondary">

        <div class="fs-5">
          <strong>Template Placeholders</strong>
        </div>
  
        <div class="py-2">
          <details open>
            <summary class="fw-bold">${playbook_title}</summary>
            <div class="small ms-3">Playbook event title or description</div>
          </details>
          <details open>
            <summary class="fw-bold">${event_date}</summary>
            <div class="small ms-3">Date of the event</div>
          </details>
          <details open>
            <summary class="fw-bold">${event_time}</summary>
            <div class="small ms-3">Time of the event</div>
          </details>
          <details open>
            <summary class="fw-bold">${agent_name}</summary>
            <div class="small ms-3">Agent name from where the event was generated</div>
          </details>
          <details open>
            <summary class="fw-bold">${agent_id}</summary>
            <div class="small ms-3">Agent name from where the event was generated</div>
          </details>
          <details open>
            <summary class="fw-bold">${agent_ip}</summary>
            <div class="small ms-3">Agent IP address from where the event was generated</div>
          </details>
          <details open>
            <summary class="fw-bold">${file}</summary>
            <div class="small ms-3">File name from the event</div>
          </details>
          <details open>
            <summary class="fw-bold">${rule_level}</summary>
            <div class="small ms-3">Event Rule level or severity</div>
          </details>
          <details open>
            <summary class="fw-bold">${organization_name}</summary>
            <div class="small ms-3">Organization Name</div>
          </details>
          <details open>
            <summary class="fw-bold">${organization_email}</summary>
            <div class="small ms-3">Organization contact email address</div>
          </details>
        </div>
  
      </div>

      </div>

    </div>

</form>


<script>

    let form_submission_fired = false;

    // make quill editors
    const body_editor = new Quill('#body-editor', QUILL_OPTIONS);
    
    /**
     * Submit the template form.
     * 
     * If type is 'load', load the preview in the page.
     * If type is not 'load', check if the form is valid, and if it is, show a confirmation dialog.
     * If the user confirms, submit the form.
     * 
     * @param {string} type - 'load' or a string that is not 'load'
     */
    async function submit_form(type) {

        const form = document.getElementById("edit-template");

        form_submission_fired = true;

        if (type == 'load') {

            // load the preview
            $("#load-subject").text(form.subject.value);
            $("#load-body").html(body_editor.root.innerHTML);

        } else {

            if (!form.checkValidity()) {
              form.reportValidity();
              return;
            }

            if (type == 'create') {

              let rule_id = form["rule"].value;

              fetchDynamicData({
                url: `/dashboard/templates/check/unique/${rule_id}`
              }, async (response) => {

                if (response?.unique) {

                  let confirm = await customConfirm("Are you sure to create new template?");

                  if (confirm) {

                    form.body.value = body_editor.root.innerHTML;
                    form.edit.value = type;
                    form.submit();

                  }

                } else {

                  toast("Template rule already exists", "Please set another unique rule ID", 1);
                  return;

                }

              })

            } else {

              let confirm = await customConfirm("Are you sure to update this template?");

              if (confirm) {

                form.body.value = body_editor.root.innerHTML;
                form.edit.value = type;
                form.submit();

              }

            }

        }
        
    }
    
    window.addEventListener('beforeunload', function (e) {

        if (!form_submission_fired) {
            e.preventDefault();
        }

    });


</script>