<link rel="stylesheet" href="/styles/progress-steps.css">
<link href="/styles/select2.css" rel="stylesheet" />

<!-- Circles which indicates the steps of the form: -->
<div id="step-indicator" class="d-flex gap-2 justify-content-center align-items-center mt-4 mb-2">
  <span class="step">1</span>
  <span class="step">2</span>
  <span class="step">3</span>
  <span class="step">4</span>
</div>

<style>
  .active {
    color: var(--bs-light);
    background: var(--bs-primary);
  }
</style>

<form class="col-md-8 user-selection-form-wrapper" id="create-ticket" action="/dashboard/tickets/create" method="POST" enctype="multipart/form-data">

  <!-- basic information -->
  <div class="tab p-4 bg-white rounded shadow mb-3">

    <div class="">

      <div class="fs-4 fw-bold mb-3 py-1 border-bottom">Basic Information</div>
      <div class="">

        <div class="d-flex gap-3">
          <div class="col-md-3">
            <%- include("../../components/form/input-box.ejs", {
                        label: "Tenant",
                        name: "tenant",
                        placeholder: "All Tenants",
                        extra: "readonly"
                    }) %>
          </div>
          <%- include("../../components/form/input-box.ejs", {
                    label: "Ticket Title",
                    name: "title",
                    required: true,
                    value: pre_detec?.title || "",
                    placeholder: "Title for the Ticket"
                }) %>
        </div>


        <div class="d-flex gap-3">

          <%- include("../../components/form/select-box.ejs", {
                    label: "Ticket Type",
                    name: "type",
                    required: true,
                    options: [
                        {
                            value: "Incident",
                            option: "Incident"
                        },
                        {
                            value: "Problem",
                            option: "Problem"
                        },
                        {
                            value: "Service Request",
                            option: "Service Request"
                        }
                    ]
                }) %>

          <%- include("../../components/form/select-box.ejs", {
                    label: "Ticket Criticality",
                    name: "criticality",
                    required: true,
                    selected: pre_detec?.critic || "Low",
                    options: [
                        {
                            value: "Low",
                            option: "Low"
                        },
                        {
                            value: "Medium",
                            option: "Medium"
                        },
                        {
                            value: "High",
                            option: "High"
                        }
                    ]
                }) %>

          <%- include("../../components/form/select-box.ejs", {
                    label: "Ticket Reminder",
                    name: "reminder_frequency",
                    required: true,
                    selected: "2",
                    options: [
                        {
                            value: "1",
                            option: "Everyday"
                        },
                        {
                            value: "2",
                            option: "Every 2 days"
                        },
                        {
                            value: "3",
                            option: "Every 3 days"
                        },
                        {
                            value: "4",
                            option: "Every 4 days"
                        }
                    ]
                }) %>

        </div>

      </div>
    </div>
    <div class="d-flex gap-3">

      <div class="w-100">
        <%- include("../../components/form/select-box.ejs", {
                label: `Creation Template`,
                name: "template",
                required: true,
                options: templates.filter(template => {
                    if (template.action === "ticket_created") return true;
                }).map(template => {
                    return {value: template.sid, option: template.title}
                }),
                help: "Template that will be followed to send alert to people when ticket is created by any permitted user."
            }) %>
      </div>

      <div class="w-100">
        <%- include("../../components/form/select-box.ejs", {
                label: "Closing Template",
                name: "template",
                required: true,
                options: templates.filter(template => {
                    if (template.action === "ticket_closed") return true;
                }).map(template => {
                    return {value: template.sid, option: template.title}
                })
            }) %>
        <!-- <details>
                <summary>Info</summary>
                <p>
                    This is template (EMAIL/SMS) that will be followed to send alert to people when ticket is closed by any permitted user.
                </p>
            </details> -->
      </div>

      <div class="w-100">
        <%- include("../../components/form/select-box.ejs", {
                label: "Expiry Template",
                name: "template",
                required: true,
                options: templates.filter(template => {
                    if (template.action === "ticket_expired") return true;
                }).map(template => {
                    return {value: template.sid, option: template.title}
                })
            }) %>
        <!-- <details>
                <summary>Info</summary>
                <p>
                    This is template (EMAIL/SMS) that will be followed to send alert to people when ticket is expired automatically.
                </p>
            </details> -->
      </div>

    </div>

  </div>

  <!-- Ticket notifications -->
  <div class="tab p-4 bg-white rounded shadow mb-3">

    <div class="fs-4 fw-bold mb-3 d-flex justify-content-between">
      <div>
        Ticket Notification
      </div>
      <div class="d-flex fs-6">
        <div class="form-check form-switch d-flex align-items-center">
          <label class="form-check-label w-100 ms-3 clickable">
            <input name="send_email" class="form-check-input" type="checkbox" data-toggle="switchbutton" checked>
            <div class="fw-bold">
              Send Email
            </div>
          </label>
        </div>
        <div class="form-check form-switch d-flex align-items-center">
          <label class="form-check-label w-100 ms-3 clickable">
            <input name="send_sms" class="form-check-input" type="checkbox" data-toggle="switchbutton">
            <div class="fw-bold">
              Send SMS
            </div>
          </label>
        </div>
      </div>
    </div>
    <div class="form-group py-1">
      <label class="fw-bold text-primary mb-1">Select Workflow</label>
      <div class="d-flex gap-3">
        <select id="workflow-selectbox" name="workflow" onchange="previewWorkflow(this)" required>
          <option value="default">
            Choose Workflow
          </option>
          <% workflows.forEach(workflow => { %>
          <option value="<%= workflow.sid %>">
            <%= workflow.sid %> :
            <%= locals.format.truncateText(workflow.title, 40) %>
          </option>
          <% }) %>
        </select>
        <div>
          <a href="/dashboard/workflow/create#Workflow" class="btn btn-secondary rounded-pill text-nowrap" target="_blank">
            <i class="fa fa-external-link"></i>
            <span class="d-none d-md-inline ms-1">Create New</span>
          </a>
        </div>
      </div>
    </div>
    <div id="workflow-preview" class="my-3">
      <!-- dynamically loaded via previewWorkflow() -->
    </div>

  </div>

  <!-- attach files -->
  <div class="tab p-4 bg-white rounded shadow mb-3">

    <div class="py-2 border-bottom mb-3">
      <div class="d-flex justify-content-between">
        <h3 class="fs-4 fw-bold ">
          <i class="fa fa-file"></i>
          Attach files (if any)
        </h3>
      </div>
    </div>

    <div class="">

      <%- include("../../components/files-upload.ejs", {
            already_added: 0
        }) %>

    </div>

    <div class="text-secondary">
      Upload upto <strong>5 files </strong> from your computer.
      <div>
        Max file size: <strong>10 MB</strong>
      </div>
      <div>
        Allowed files: <strong><%= allowed_files %></strong>
      </div>
    </div>

  </div>

  <!-- Confirm Selection -->
  <div class="tab col-md-10 mx-auto p-4 py-5 bg-white rounded-pill shadow mb-3 text-center scale-in-center">

    <div class="display-3">
      <i class="fa-regular fa-circle-question"></i>
    </div>
    <h5 class="fs-5 fw-bold">
      Are you ready to submit?
    </h5>

    <div class="">
      Please press submit if you want to create a new ticket.
    </div>

  </div>

  <div class="d-none">
    <input type="hidden" name="log_id" value="<%= log_data?.log?.id || "" %>">
  </div>

  <div class="text-end mt-4">
    <button class="btn btn-secondary rounded-pill px-4 me-2" type="button" id="prevBtn" onclick="nextPrev(-1)">
      <i class="fa fa-arrow-left"></i>
      Previous
    </button>
    <button class="btn btn-success rounded-pill px-4" type="button" id="nextBtn" onclick="toggleSection('#progress-next-loading-icon'); nextPrev(1)">
      Next
      <i class="fa fa-arrow-right"></i>
    </button>
  </div>

</form>

<%- include('./user-selection') %>

<script>
  window.eitix_progress_form_target = "#create-ticket";
</script>
<script src="/scripts/progress-steps.js"></script>
<script src="/scripts/select2.js"></script>

<script>
  let form_submission_fired = false;

  // adding custom validator
  customValidator = (callback) => {

    // This function deals with validation of the form fields
    let x, y, i, valid = true;
    let form = document.querySelector(window.eitix_progress_form_target);
    x = document.getElementsByClassName("tab");
    y = x[currentTab].getElementsByTagName("input");

    if (currentTab === 0) {

      let title = form["title"].value;

      fetchDynamicData({
        url: `/content/check/value?col=tickets&field=title&val=${title}`
      }, (response) => {

        if (response?.unique) {

          return callback(true);

        } else {

          toast("Ticket already exists", "Please set another unique title", 1);
          return callback(false);

        }

      })

    } else if (currentTab === 1) {

      if (form['workflow'].value === "default") {
        toast("Workflow not selected", "Please select an workflow", 1);
        callback(false);
      } else {
        callback(true);
      }

    } else if (currentTab === 3) {

      form_submission_fired = true;
      return callback(true);

    } else {

      return callback(true);

    }


  }

  $('#workflow-selectbox').select2({
    width: '100%',
    placeholder: '🔍 Search Workflow',
  });

  window.addEventListener('beforeunload', function(e) {

    if (!form_submission_fired) {
      e.preventDefault();
    }

  });
</script>