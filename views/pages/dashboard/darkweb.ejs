<%# Main dashboard view for Dark Web Monitoring with a light-theme UI %>

<style>
  /* Light Themed Organization Card Styles */
  .org-card {
    background: #ffffff;
    border: 1px solid #e0e5ec;
    border-radius: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .org-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid #e0e5ec;
  }

  .org-card-header h5 {
    margin-bottom: 0;
    font-weight: 600;
    color: #343a40;
  }

  .org-card-actions .btn {
    background: #f0f2f5;
    border: 1px solid #dee2e6;
    color: #6c757d;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .org-card-actions .btn:hover {
    background-color: #e9ecef;
    color: #212529;
    border-color: #dee2e6;
  }

  .org-card-actions .btn-danger:hover {
    background-color: #dc3545;
    border-color: #dc3545;
    color: white;
  }

  .org-card-body {
    padding: 1.75rem;
  }

  .data-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid #f0f2f5;
    font-size: 0.95rem;
  }

  .data-row:first-child {
    border-top: none;
  }

  .data-row .icon {
    margin-right: 1rem;
    color: #6c757d;
    width: 20px;
    text-align: center;
  }

  .data-row span:first-child {
    display: flex;
    align-items: center;
    color: #6c757d;
  }

  .data-row .value {
    font-weight: 600;
    color: #212529;
    background-color: #f0f2f5;
    padding: 0.2rem 0.6rem;
    border-radius: 0.5rem;
    min-width: 30px;
    text-align: center;
  }

  /* Upgraded Empty State Styles (Light Theme) */
  .empty-state-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
  }

  .empty-state-card {
    background-color: #ffffff;
    border: 1px solid #e0e5ec;
    border-radius: 1rem;
    padding: 3rem 4rem;
    text-align: center;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
  }

  .empty-state-card .icon {
    font-size: 3rem;
    color: #6c757d;
    margin-bottom: 1.5rem;
  }

  .empty-state-card p {
    color: #6c757d;
    margin-bottom: 2rem;
  }

  /* Light Themed Wizard Styles */
  .wizard-modal .modal-content {
    background-color: #ffffff !important;
    color: #212529;
    border: 1px solid #dee2e6;
    border-radius: 1rem;
  }

  .wizard-modal .modal-header,
  .wizard-modal .modal-footer {
    border-color: #dee2e6;
    padding: 1.5rem 2rem;
    background-color: #f8f9fa !important;
  }

  .wizard-modal .modal-title {
    font-weight: 600;
  }

  .wizard-modal .btn-close {
    filter: none;
  }

  .wizard-modal .modal-lg {
    max-width: 900px;
  }

  .wizard-content {
    display: flex;
  }

  .wizard-nav {
    width: 250px;
    border-right: 1px solid #dee2e6;
    padding: 1.5rem;
    flex-shrink: 0;
    background-color: #faf9f8 !important;
  }

  .wizard-nav .nav-link {
    color: #6c757d;
    margin-bottom: 0.5rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .wizard-nav .nav-link.active {
    color: #ff7f3f;
    background-color: #fff4e7 !important;
    font-weight: 600;
  }

  .wizard-nav .nav-link:not(.active):hover {
    background-color: #e9ecef !important;
  }

  .wizard-steps {
    background-color: #ffffff !important;
  }

  .wizard-step {
    display: none;
    width: 100%;
    padding: 2.5rem 3rem;
    background-color: #ffffff !important;
  }

  .wizard-step.active {
    display: block;
  }

  .wizard-step h4 {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #212529;
  }

  .wizard-step p {
    margin-bottom: 1.5rem;
    color: #6c757d;
  }

  .wizard-modal .form-control,
  .wizard-modal .form-select {
    background-color: #ffffff !important;
    color: #212529 !important;
    border: 1px solid #ced4da !important;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
  }

  .wizard-modal .form-control:focus,
  .wizard-modal .form-select:focus {
    border-color: #ffad84 !important;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, .25) !important;
  }

  .address-section {
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    background-color: #faf9f8 !important;
  }

  .address-section h5 {
    color: #212529;
    font-weight: 600;
    border-bottom: 1px solid #dee2e6;
    padding-bottom: 0.75rem;
    margin-bottom: 1rem; 
  }

  /* Standard Bootstrap buttons for light modal footer */
  .wizard-modal .modal-footer .btn-primary,
  .wizard-modal .modal-footer .btn-success {
    color: #fff;
    background-color: #ff7f3f;
    border-color: #ff7f3f;
  }

  .wizard-modal .modal-footer .btn-success {
    background-color: #198754;
    border-color: #198754;
  }

  .wizard-modal .modal-footer .btn-secondary {
    color: #fff;
    background-color: #7d786c;
    border-color: #7d7a6c;
  }
</style>

<div class="col-12">
  <% if (asset) { %>
  <div class="col-xl-4 col-md-6 mb-4 mx-auto">
    <div class="org-card">
      <div class="org-card-header">
        <h5><%= asset.organizationName %></h5>
        <div class="org-card-actions">
          <a href="/dashboard/darkWeb/details" class="btn" title="View Details"><i class="fas fa-eye"></i></a>
          <button class="btn edit-btn" title="Edit Organization" data-bs-toggle="modal" data-bs-target="#wizardModal" data-org='<%- JSON.stringify(asset) %>'>
            <i class="fas fa-pencil-alt"></i>
          </button>
          <form action="/dashboard/darkWeb/delete-monitoring" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this organization?');">
            <button type="submit" class="btn btn-danger" title="Delete Organization"><i class="fas fa-trash-alt"></i></button>
          </form>
        </div>
      </div>
      <div class="org-card-body">
        <div class="data-row">
          <span><i class="fas fa-globe icon"></i> Dark Web</span>
          <span class="value"><%= asset.scanResult && asset.scanResult.data ? asset.scanResult.data.length : 0 %></span>
        </div>
        <div class="data-row">
          <span><i class="fas fa-user-secret icon"></i> Company Impersonation</span>
          <span class="value">0</span>
        </div>
        <div class="data-row">
          <span><i class="fas fa-exclamation-triangle icon"></i> Threat Intelligence</span>
          <span class="value">0</span>
        </div>
        <div class="data-row">
          <span><i class="fas fa-bug icon"></i> Vulnerabilities</span>
          <span class="value">0</span>
        </div>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="col-12 empty-state-container">
    <div class="empty-state-card">
      <div class="display-4 mb-3">
        <i class="fas fa-spider text-secondary"></i>
      </div>
      <h4 class="fw-bold mb-3">Start Monitoring Your Organization in the DarkWeb.</h4>
      <p>Add your first organization to begin scanning the dark web for compromised credentials and threats.</p>
      <button class="btn btn-primary rounded-pill" id="addOrgBtn" data-bs-toggle="modal" data-bs-target="#wizardModal">
        <i class="fas fa-plus me-2"></i>Add Organization
      </button>
    </div>
  </div>
  <% } %>
</div>

<!-- Wizard Modal -->
<div class="modal fade wizard-modal" id="wizardModal" tabindex="-1" aria-labelledby="wizardModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="" method="POST" id="wizardForm">
        <div class="modal-header">
          <h5 class="modal-title" id="wizardModalLabel">New Organization</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-0">
          <div class="wizard-content">
            <div class="wizard-nav">
              <div class="nav flex-column nav-pills">
                <a class="nav-link active" id="step1-tab" href="#step1"><i class="fas fa-building fa-fw"></i> Organization</a>
                <a class="nav-link" id="step2-tab" href="#step2"><i class="fas fa-search fa-fw"></i> Assets</a>
                <a class="nav-link" id="step3-tab" href="#step3"><i class="fas fa-address-book fa-fw"></i> Contacts</a>
                <a class="nav-link" id="step4-tab" href="#step4"><i class="fas fa-key fa-fw"></i> API Key</a>
              </div>
            </div>
            <div class="wizard-steps">
              <!-- Step 1: Organization -->
              <div class="wizard-step active" id="step1">
                <h4>Organization Details</h4>
                <p>Start by telling us about your organization.</p>
                <input type="text" class="form-control mb-3" name="organizationName" placeholder="Organization name" required>
                <textarea class="form-control" name="organizationDescription" rows="4" placeholder="A brief description of your organization"></textarea>
              </div>
              <!-- Step 2: Assets -->
              <div class="wizard-step" id="step2">
                <h4>Assets to Monitor</h4>
                <p>Select the primary digital asset you want to scan.</p>
                <select class="form-select mb-3" name="searchType" id="searchTypeSelect">
                  <option value="domain">Domain</option>
                  <option value="ip">IP Address</option>
                  <option value="username">Username</option>
                  <option value="phone">Phone Number</option>
                </select>
                <div id="domain-input-group">
                  <input type="text" class="form-control" name="domain" placeholder="example.com">
                </div>
                <div id="ip-input-group" style="display: none;">
                  <input type="text" class="form-control" name="ip" placeholder="1.1.1.1">
                </div>
                <div id="username-input-group" style="display: none;">
                  <input type="text" class="form-control" name="username" placeholder="company_username">
                </div>
                <div id="phone-input-group" style="display: none;">
                  <input type="tel" class="form-control" name="phone" placeholder="+1234567890">
                </div>
              </div>
              <!-- Step 3: Contacts -->
              <div class="wizard-step" id="step3">
                <h4>Contact Points</h4>
                <p>Provide contact points for reporting and alerts (Primary Address is required).</p>
                <div class="address-section">
                  <h5>Primary Contact</h5>
                  <input type="text" class="form-control mb-2" name="primaryContactName" placeholder="Name">
                  <input type="email" class="form-control mb-2" name="primaryContactEmail" placeholder="Email">
                  <input type="tel" class="form-control mb-2" name="primaryContactPhone" placeholder="Phone Number">
                  <input type="text" class="form-control" name="primaryContactAddress" placeholder="Address" required>
                </div>
                <div class="address-section">
                  <h5>Secondary Contact</h5>
                  <input type="text" class="form-control mb-2" name="secondaryContactName" placeholder="Name">
                  <input type="email" class="form-control mb-2" name="secondaryContactEmail" placeholder="Email">
                  <input type="tel" class="form-control mb-2" name="secondaryContactPhone" placeholder="Phone Number">
                  <input type="text" class="form-control" name="secondaryContactAddress" placeholder="Address">
                </div>
                <div class="address-section">
                  <h5>Tertiary Contact</h5>
                  <input type="text" class="form-control mb-2" name="tertiaryContactName" placeholder="Name">
                  <input type="email" class="form-control mb-2" name="tertiaryContactEmail" placeholder="Email">
                  <input type="tel" class="form-control mb-2" name="tertiaryContactPhone" placeholder="Phone Number">
                  <input type="text" class="form-control" name="tertiaryContactAddress" placeholder="Address">
                </div>
              </div>
              <!-- Step 4: API Key -->
              <div class="wizard-step" id="step4">
                <h4>API Key Configuration</h4>
                <p>Provide your InsecureWeb API key to perform scans.</p>
                <div class="input-group">
                  <input type="password" class="form-control" name="apiKey" id="apiKeyInput" placeholder="Enter your ISW API Key" required>
                  <button class="btn btn-outline-secondary" type="button" id="toggleApiKey">
                    <i class="fas fa-eye"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer d-flex ">
          <button type="button" class="btn btn-secondary" id="prevButton" disabled>Back</button>
          <div>
            <button type="button" class="btn btn-primary" id="nextButton">Continue</button>
            <button type="submit" class="btn btn-success" id="finishButton" style="display: none;">Save & Scan</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {

    // Wizard Logic
    const wizardModal = document.getElementById('wizardModal');
    const wizardForm = document.getElementById('wizardForm');
    const wizardModalLabel = document.getElementById('wizardModalLabel');
    const addOrgBtn = document.getElementById('addOrgBtn');
    const editBtn = document.querySelector('.edit-btn');

    const steps = wizardModal.querySelectorAll('.wizard-step');
    const tabs = wizardModal.querySelectorAll('.wizard-nav .nav-link');
    const prevButton = wizardModal.querySelector('#prevButton');
    const nextButton = wizardModal.querySelector('#nextButton');
    const finishButton = wizardModal.querySelector('#finishButton');
    let currentStep = 0;

    const searchTypeSelect = document.getElementById('searchTypeSelect');
    const domainGroup = document.getElementById('domain-input-group');
    const ipGroup = document.getElementById('ip-input-group');
    const usernameGroup = document.getElementById('username-input-group');
    const phoneGroup = document.getElementById('phone-input-group');
    const toggleApiKeyBtn = document.getElementById('toggleApiKey');
    const apiKeyInput = document.getElementById('apiKeyInput');
    const domainInput = wizardForm.querySelector('[name="domain"]');

    // --- NEW: Add form submission listener for domain parsing ---
    wizardForm.addEventListener('submit', function(event) {
      const searchType = searchTypeSelect.value;
      if (searchType === 'domain' && domainInput.value) {
        try {
          let url = domainInput.value.trim();
          // Prepend a protocol if one is missing to ensure the URL constructor works
          if (!/^(https?:\/\/)/i.test(url)) {
            url = 'https://' + url;
          }
          const hostname = new URL(url).hostname;
          // Remove 'www.' if it exists at the beginning of the hostname
          domainInput.value = hostname.replace(/^www\./i, '');
        } catch (e) {
          console.error("Could not parse domain input as a URL, attempting simple cleanup.", e);
          // Fallback for non-standard URLs
          domainInput.value = domainInput.value.trim()
            .replace(/^(https?:\/\/)?(www\.)?/, '')
            .split('/')[0];
        }
      }
    });

    function updateWizardState() {
      steps.forEach((step, index) => step.classList.toggle('active', index === currentStep));
      tabs.forEach((tab, index) => {
        tab.classList.toggle('active', index === currentStep);
      });
      prevButton.disabled = currentStep === 0;
      nextButton.style.display = currentStep === steps.length - 1 ? 'none' : 'inline-block';
      finishButton.style.display = currentStep === steps.length - 1 ? 'inline-block' : 'none';
    }

    function goToStep(stepIndex) {
      currentStep = stepIndex;
      updateWizardState();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        goToStep(index);
      });
    });

    function toggleAssetInputs() {
      const selectedType = searchTypeSelect.value;
      domainGroup.style.display = selectedType === 'domain' ? 'block' : 'none';
      ipGroup.style.display = selectedType === 'ip' ? 'block' : 'none';
      usernameGroup.style.display = selectedType === 'username' ? 'block' : 'none';
      phoneGroup.style.display = selectedType === 'phone' ? 'block' : 'none';
    }

    searchTypeSelect.addEventListener('change', toggleAssetInputs);

    function validateStep(stepIndex) {
      const step = steps[stepIndex];
      const inputs = step.querySelectorAll('input[required], select[required], textarea[required]');
      for (const input of inputs) {
        if (!input.value.trim()) {
          alert(`'${input.placeholder || input.name}' is a required field.`);
          input.focus();
          return false;
        }
      }
      return true;
    }

    nextButton.addEventListener('click', () => {
      if (validateStep(currentStep) && currentStep < steps.length - 1) {
        goToStep(currentStep + 1);
      }
    });

    prevButton.addEventListener('click', () => {
      if (currentStep > 0) goToStep(currentStep - 1);
    });

    toggleApiKeyBtn.addEventListener('click', () => {
      const type = apiKeyInput.getAttribute('type') === 'password' ? 'text' : 'password';
      apiKeyInput.setAttribute('type', type);
      toggleApiKeyBtn.querySelector('i').classList.toggle('fa-eye');
      toggleApiKeyBtn.querySelector('i').classList.toggle('fa-eye-slash');
    });

    function setupWizardForAdd() {
      wizardModalLabel.textContent = 'Add New Organization';
      wizardForm.action = '/dashboard/darkWeb/update-monitoring';
      wizardForm.reset();
      apiKeyInput.value = '';
      apiKeyInput.placeholder = 'Enter your ISW API Key';
      apiKeyInput.disabled = false;
      apiKeyInput.required = true;
      goToStep(0);
      toggleAssetInputs();
    }

    function setupWizardForEdit(orgData) {
      wizardModalLabel.textContent = 'Edit Organization';
      wizardForm.action = '/dashboard/darkWeb/update-monitoring';
      wizardForm.reset();

      wizardForm.querySelector('[name="organizationName"]').value = orgData.organizationName || '';
      wizardForm.querySelector('[name="organizationDescription"]').value = orgData.organizationDescription || '';
      wizardForm.querySelector('[name="searchType"]').value = orgData.searchType || 'domain';
      wizardForm.querySelector('[name="domain"]').value = orgData.name || '';
      wizardForm.querySelector('[name="ip"]').value = orgData.ip || '';
      wizardForm.querySelector('[name="username"]').value = orgData.username || '';
      wizardForm.querySelector('[name="phone"]').value = orgData.phone || '';

      // Secure the API key field
      if (!apiKeyInput.value) {

        apiKeyInput.placeholder = '******** (locked)';
        apiKeyInput.required = false; // Not required on edit

      }

      if (orgData.contacts) {
        wizardForm.querySelector('[name="primaryContactName"]').value = orgData.contacts.primary?.name || '';
        wizardForm.querySelector('[name="primaryContactEmail"]').value = orgData.contacts.primary?.email || '';
        wizardForm.querySelector('[name="primaryContactPhone"]').value = orgData.contacts.primary?.phone || '';
        wizardForm.querySelector('[name="primaryContactAddress"]').value = orgData.contacts.primary?.address || '';

        wizardForm.querySelector('[name="secondaryContactName"]').value = orgData.contacts.secondary?.name || '';
        wizardForm.querySelector('[name="secondaryContactEmail"]').value = orgData.contacts.secondary?.email || '';
        wizardForm.querySelector('[name="secondaryContactPhone"]').value = orgData.contacts.secondary?.phone || '';
        wizardForm.querySelector('[name="secondaryContactAddress"]').value = orgData.contacts.secondary?.address || '';

        wizardForm.querySelector('[name="tertiaryContactName"]').value = orgData.contacts.tertiary?.name || '';
        wizardForm.querySelector('[name="tertiaryContactEmail"]').value = orgData.contacts.tertiary?.email || '';
        wizardForm.querySelector('[name="tertiaryContactPhone"]').value = orgData.contacts.tertiary?.phone || '';
        wizardForm.querySelector('[name="tertiaryContactAddress"]').value = orgData.contacts.tertiary?.address || '';
      }

      goToStep(0);
      toggleAssetInputs();
    }

    if (addOrgBtn) {
      addOrgBtn.addEventListener('click', setupWizardForAdd);
    }

    if (editBtn) {
      editBtn.addEventListener('click', () => {
        const orgData = JSON.parse(editBtn.getAttribute('data-org'));
        setupWizardForEdit(orgData);
      });
    }

    // Initial setup on page load
    updateWizardState();
    toggleAssetInputs();
  });
</script>