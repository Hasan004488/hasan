<div class="d-flex gap-3">
    <div class="col-md">
      <%- include("../../../components/form/input-box.ejs", {
        label: "Report Header Title",
        name: "title",
        value: config.title || 'A summary of the system activity',
        required: true,
      }) %>
    </div>
    <div class="col-md">
      <%- include("../../../components/form/select-box.ejs", {
        label: "Data Range",
        name: "data_range",
        selected: config.data_range || "7",
        event: "onchange=globalRangeUpdate(this)",
        options: [
          {
            value: "1",
            option: "Daily"
          },
          {
            value: "7",
            option: "Last 7 Days"
          },
          {
            value: "15",
            option: "Last 15 Days"
          },
          {
            value: "30",
            option: "Last 30 Days"
          }
        ]
      }) %>
    </div>
  </div>

  <div class="d-flex justify-content-between mb-3">
    <div class="fw-bold text-primary">Please select reports to include</div>
    <div class="">
      <button type="button" class="btn btn-sm btn-primary rounded-pill me-2" onclick="selectAllReports()">
        <i class="fa fa-check"></i>
        Select All
      </button>
      <button type="button" class="btn btn-sm btn-secondary rounded-pill" onclick="selectAllReports(false)">
        <i class="fa fa-ban"></i>
        Deselect All
      </button>
    </div>   
  </div>

  <div id="all-reports" class="py-4 form-control d-flex flex-wrap permission-switches rounded overflow-auto max-small">

    <% data.forEach((report, idx) => { %>
      
      <div class="col-6 p-3">
        <div id="report-<%= report.sid %>" class="report-box py-3 form-check form-switch d-flex align-items-center hover-gray rounded-3 border border-3">
          <label class="form-check-label w-100 ms-3 clickable">
            <input name="reports" value="<%= report.sid %>" class="report-checkbox form-check-input clickable" type="checkbox" data-toggle="switchbutton" <%= config?.reports?.includes(report.sid) ? "checked" : "" %> onchange="check('report-<%= report.sid %>')">
            <details>
              <summary class="fw-bold text-secondary">
                <span class="badge bg-primary rounded-pill mb-2">ID: <%= report.sid %></span>
                <% if (report.realtime) { %>
                  <span class="badge bg-danger" title="It may slow down the process for realtime calculation">
                    <i class="fa fa-clock"></i>
                    Takes Time
                  </span>
                <% } else { %>
                  <span class="badge bg-success">Instant</span>
                <% } %>
                <% if (report.long_report) { %>
                  <span class="badge bg-secondary" title="It may bring a lot of pages to the report">
                    <i class="fa fa-book"></i>
                    Multi-Page
                  </span>
                <% } %>
                <br/>
                <!-- <i class="fa-solid fa-chart-column"></i> -->
                <span><%= report.title %></span>
              </summary>
              <div class="my-3 pe-3">
                <input name="<%= report.sid %>" type="text" value="<%= report.title %>" class="d-none">
                <%- include("../../../components/form/text-box.ejs", {
                  label: "Report Top Description",
                  name: report.sid,
                  value: report.top,
                  rows: 5,
                  required: true
                }) %>
                <%- include("../../../components/form/text-box.ejs", {
                  label: "Report Bottom Description",
                  name: report.sid,
                  value: report.bottom,
                  rows: 3,
                  placeholder: "Write more information after the chart"
                }) %>
                <%- include("../../../components/form/select-box.ejs", {
                  label: "Data Range",
                  name: report.sid,
                  selected: report.range || "7",
                  disabled: report.range ? true : false,
                  options: [
                    {
                      value: "1",
                      option: "Today"
                    },
                    {
                      value: "7",
                      option: "Last 7 Days"
                    },
                    {
                      value: "15",
                      option: "Last 15 Days"
                    },
                    {
                      value: "30",
                      option: "Last 30 Days"
                    }
                  ]
                }) %>
              </div>
            </details>
          </label>
        </div>
      </div>

    <% }) %>

</div>