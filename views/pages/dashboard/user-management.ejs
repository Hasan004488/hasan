<style>
  .permission-switches>div:hover {
    background-color: var(--bs-white);
    color: var(--bs-dark);
  }

  .form-check-input {
    cursor: pointer;
  }
</style>

<div class="col-12">
  <div class="p-4 bg-white rounded shadow">

    <div class="d-flex align-items-center justify-content-between">

      <h4 class="fw-bold">
        Users Listed by Role:
        <strong class="text-primary" id="selected-role">
          <%= active.charAt(0).toUpperCase() + active.slice(1) %>
        </strong>
      </h4>

      <div class="d-flex gap-2 align-items-center">
        <div>
          <a id="Create-User" href="/dashboard/users/create#Users" class="btn btn-primary px-3 rounded-pill">
            <i class="fa-solid fa-user-plus me-2"></i>
            Create New User
          </a>
        </div>
        <div class="dropdown">
          <button class="btn rounded-pill btn-secondary dropdown-toggle" type="button" id="users-manage-settings" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa fa-user"></i> Select Role
          </button>
          <ul class="dropdown-menu" aria-labelledby="users-manage-settings">
            <li>
              <button onclick="changeURL('/dashboard/users/manage/data/user'); selectRole('user')" class="dropdown-item">
                All Users
              </button>
            </li>
            <% roles.forEach(role=> { %>
            <li>
              <button onclick="changeURL('/dashboard/users/manage/data/<%= role.name %>'); selectRole('<%= role.name %>')" class="dropdown-item">
                <%= role.name %>
              </button>
            </li>
            <% }) %>
          </ul>
        </div>
        <%- include('components/search-control-buttons') %>
      </div>

    </div>

    <%- include("../../components/body/search-data.ejs", {
          options: [
            { name: "Full Name", property: "full_name" },
            { name: "User ID", property: "sid" },
            { name: "Email", property: "email" }
          ],
          total_text: "Total users available:"
        }) %>

    <%- include("../../components/body/data-table.ejs") %>

  </div>
</div>

<script>
  loadData(true, true);

  function selectRole(role_name) {
    $("#selected-role").text(role_name.charAt(0).toUpperCase() + role_name.slice(1));
  }

  function deleteUser(user_id) {

    fetch(`/dashboard/users/deleteable?id=${user_id}`, {
        method: 'GET'
      })
      .then(response => response.json())
      .then(data => {

        if (data.deletable) {

          updateData('Are sure to permanently delete this account?', '/dashboard/users/delete', user_id, 'GET')

        } else {

          let popup_message = document.querySelector("#popup-modal .popup-message");
          let popup_body = document.querySelector("#popup-modal .popup-body");

          popup_message.innerHTML = `User is involved in various places!`;
          popup_body.innerHTML = `
          <strong>Workflows:</strong> ${data?.involvement.join(', ')}.
          <div>
            Please delete the user from those places first. <br/>
            <a href="/dashboard/Workflow#Workflow" class="small text-underline">Visit Workflow Page</a>
          </div>
          `;

          // popup the new tenant key
          toggle('#popup-modal');

        }
      })
      .catch(error => console.error('Error:', error));

  }
</script>