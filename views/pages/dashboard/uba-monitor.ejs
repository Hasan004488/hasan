<div class="col-12">
    <div class="d-flex gap-2 m-0">
        <div id="chart1" class="dashboard-block col-md">
            <div class="d-flex justify-content-between mb-2">
                <div class="fs-5 fw-bold d-flex align-items-center gap-1">
                    Attack Trend
                    <i title="Ticket Status displays the total number of open and closed tickets from the last 24 hours."
                        class="fa fa-circle-info text-muted cursor-help ms-1 small"></i>
                </div>
            </div>
            <div id="graph1"></div>
        </div>
        <div id="c" class="dashboard-block col-md">
            <div class="d-flex justify-content-between mb-2">
                <div class="fs-5 fw-bold d-flex align-items-center gap-1">
                    Login Rate
                    <i title="Ticket Status displays the total number of open and closed tickets from the last 24 hours."
                        class="fa fa-circle-info text-muted cursor-help ms-1 small"></i>
                </div>
            </div>
            <div id="graph2"></div>
        </div>
        <div id="c" class="dashboard-block col-md">
            <div class="d-flex justify-content-between mb-2">
                <div class="fs-5 fw-bold d-flex align-items-center gap-1">
                    Risk Category
                    <i title="Ticket Status displays the total number of open and closed tickets from the last 24 hours."
                        class="fa fa-circle-info text-muted cursor-help ms-1 small"></i>
                </div>
            </div>
            <div id="graph3"></div>
        </div>
        <div id="c" class="dashboard-block col-md">
            <div class="d-flex justify-content-between mb-2">
                <div class="fs-5 fw-bold d-flex align-items-center gap-1">
                    Learning Models
                    <i title="Ticket Status displays the total number of open and closed tickets from the last 24 hours."
                        class="fa fa-circle-info text-muted cursor-help ms-1 small"></i>
                </div>
            </div>
            <div id="graph4"></div>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="d-md-flex gap-2">
        <div class="col bg-white rounded shadow p-3">
            <div>
                <h5 class="fw-bold mb-3 d-flex justify-content-between align-items-center">
                    Users with highest risk score
                    <button class="btn btn-sm btn-primary rounded-pill">
                        View All
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </h5>
                <ul class="list-group bg-light overflow-auto" style="max-height: 260px;">
                    <% for (let i=0; i < 10; i++) { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="p-1 px-3 rounded bg-secondary-light text-dark">
                                <i class="fa fa-user"></i>
                                saiful.alam.khan
                            </span>
                            <span class="fs-5">
                                <i class="fa fa-eye"></i>
                                15
                            </span>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
        <div class="col bg-white rounded shadow p-3">
            <div>
                <h5 class="fw-bold mb-3 d-flex justify-content-between align-items-center">
                    Users with recent risk activity
                    <button class="btn btn-sm btn-primary rounded-pill">
                        View All
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </h5>
                <ul class="list-group bg-light overflow-auto" style="max-height: 260px;">
                    <% for (let i=0; i < 10; i++) { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="p-1 px-3 rounded bg-secondary-light text-dark">
                                <i class="fa fa-user"></i>
                                saiful.alam.khan
                            </span>
                            <span class="fs-5">
                                <i class="fa fa-eye"></i>
                                +4
                            </span>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="/scripts/apex-charts.js"></script>

<script>

    loadDynamicData({
        container: "#monitor-users-container", 
        url: "/content/dashboard/agents",
        type: "GET"
    }, (data) => {

        $("#wazuh-active-count").html(data.wazuh.active || 0);
        $("#wazuh-inactive-count").html(data.wazuh.inactive || 0);
        $("#cloud-active-count").html(data.cloud.active || 0);
        $("#cloud-inactive-count").html(data.cloud.inactive || 0);

    }, 60000); // 1 minute

    let options = {
        chart: {
            height: 300,
            type: 'bar',
            stacked: true,
        },
        plotOptions: {
            bar: {
                horizontal: false,
                columnWidth: '55%',
                endingShape: 'rounded'
            }
        },
        dataLabels: {
            enabled: false
        },
        stroke: {
            show: true,
            width: 2,
            colors: ['transparent']
        },
        series: [{
            name: 'Success',
            data: Array.from({ length: 10 }, () => Math.floor(Math.random() * (30 - 10 + 1)) + 10)
        }, {
            name: 'Failure',
            data: Array.from({ length: 10 }, () => Math.floor(Math.random() * (30 - 10 + 1)) + 10),
            color: '#dc3545'
        }],
        xaxis: {
            categories: Array.from({ length: 10 }, (_, i) => {
                let date = new Date();
                date.setDate(date.getDate() - (9 - i));
                return date.toISOString().slice(0, 10);
            }),
        },
        fill: {
            opacity: 1
        },
        tooltip: {
            y: {
                formatter: function (val, opts) {
                    return val + " times" + (opts.dataPointIndex % 2 === 1 ? " (failed)" : "")
                }
            }
        }
    };

    let chart = new ApexCharts(document.querySelector("#logins-per-day"), options);

    chart.render();

    let optionsGraph1 = {
        chart: {
            height: 200,
            type: 'line',
            toolbar: {
                show: false
            },
        },
        series: [{
            name: 'Brute Force',
            data: Array.from({ length: 3 }, () => Math.floor(Math.random() * (30 - 10 + 1)) + 10)
        }, {
            name: 'Phishing',
            data: Array.from({ length: 3 }, () => Math.floor(Math.random() * (30 - 10 + 1)) + 10)
        }, {
            name: 'Malware',
            data: Array.from({ length: 3 }, () => Math.floor(Math.random() * (30 - 10 + 1)) + 10)
        }],
        xaxis: {
            categories: Array.from({ length: 10 }, (_, i) => {
                let date = new Date();
                date.setDate(date.getDate() - (9 - i));
                return date.toISOString().slice(0, 10);
            }),
        },
        stroke: {
            width: 3
        },
        markers: {
            size: 4
        }
    };

    let chartGraph1 = new ApexCharts(document.querySelector("#graph1"), optionsGraph1);

    chartGraph1.render();

    let optionsGraph2 = {
        chart: {
            height: 250,
            type: 'pie'
        },
        labels: ['Login Success', 'Login Failure'],
        series: [Math.floor(Math.random() * 100), Math.floor(Math.random() * 100)],
        colors: ['#28a745', '#dc3545'],
        legend: {
            position: 'bottom'
        },
        responsive: [{
            breakpoint: 480,
            options: {
                chart: {
                    width: 200
                },
                legend: {
                    position: 'bottom'
                }
            }
        }]
    };

    let chartGraph2 = new ApexCharts(document.querySelector("#graph2"), optionsGraph2);

    chartGraph2.render();

    let optionsGraph3 = {
        chart: {
            height: 250,
            type: 'donut'
        },
        series: [Math.floor(Math.random() * 100), Math.floor(Math.random() * 100), Math.floor(Math.random() * 100)],
        labels: ['User Privilege', 'User Time', 'User Behavior'],
        colors: ['#007bff', '#e83e8c', '#6610f2'],
        legend: {
            position: 'bottom'
        },
        responsive: [{
            breakpoint: 480,
            options: {
                chart: {
                    width: 200
                }
            }
        }]
    };

    let chartGraph3 = new ApexCharts(document.querySelector("#graph3"), optionsGraph3);

    chartGraph3.render();

    let optionsGraph4 = {
        chart: {
            height: 250,
            type: 'pie'
        },
        series: [Math.floor(Math.random() * 100), Math.floor(Math.random() * 100)],
        labels: ['User Activity', 'Risk Posture'],
        colors: ['#6610f2', '#e83e8c'],
        legend: {
            position: 'bottom'
        },
        responsive: [{
            breakpoint: 480,
            options: {
                chart: {
                    width: 200
                },
                legend: {
                    position: 'bottom'
                }
            }
        }]
    };

    let chartGraph4 = new ApexCharts(document.querySelector("#graph4"), optionsGraph4);

    chartGraph4.render();

</script>