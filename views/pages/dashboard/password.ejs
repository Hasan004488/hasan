<div class="col-md-6 mt-5">
  <div class="bg-light rounded shadow p-5">
    <div class="fs-5 fw-bold">Change Password</div>
    <small>Chnage your old password from here</small>
    <form id="password-form" action="/auth/password/update" method="POST" class="pt-3">
      <div class="form-group w-100 my-1 mb-3">
        <label class="mb-2 fw-bold text-primary">Current Password</label>
        <input name="current" type="password" class="form-control rounded-pill" placeholder="Enter your current password" minlength="6" maxlength="255">
      </div>
      <div class="">
        <div class="form-group w-100 my-1 mb-3" id="toggle-password">
          <label class="mb-2 fw-bold text-primary">Create New Password</label>
          <div class="d-flex gap-3">
            <input id="password" name="password" type="password" class="form-control rounded-pill" placeholder="Enter new Password" minlength="8" maxlength="255" required>
            <button type="button" class="btn btn-primary rounded-pill">
              <i class="fa fa-eye-slash" aria-hidden="true"></i>
            </button>
          </div>
        </div>
        <div class="">
          <small id="changePass" class="form-text"></small>
        </div>
      </div>
      <div class="form-group w-100 my-1 mb-3">
        <label class="mb-2 fw-bold text-primary">Confirm New Password</label>
        <input id="confirm-pass" name="confirm" type="password" class="form-control rounded-pill" aria-describedby="confirmHelp" placeholder="Confirm Password" minlength="8" maxlength="255" required>
        <div class="py-2">
          <small id="confirmPass" class="form-text"></small>
        </div>
      </div>
      <div class="mb-3">
        <button class="btn btn-primary rounded-pill px-5" type="submit">
          <i class="fa fa-key"></i>
          Change Password
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const pass_eye = $('#toggle-password i');
  const passInput = $('#password');
  const pwd = document.querySelector("#password");
  const confirm_pwd = document.querySelector("#confirm-pass");
  const status = document.querySelector("#confirmPass");
  const change_status = document.querySelector("#changePass");
  const form = document.querySelector("#password-form");

  let validation = {};

  form.addEventListener("submit", async e => {

    e.preventDefault();

    if (validation.isValid) {

      let confirm_submit = await customConfirm('Are you sure to update your password?');
      if (confirm_submit) form.submit();

    } else {

      return toast("Can't change password", "Password Validation Failed!", 1);

    }

  })

  $("#toggle-password button").on('click', function(e) {

    if (passInput.attr("type") == "text") {

      passInput.attr('type', 'password');
      pass_eye.addClass("fa-eye-slash");
      pass_eye.removeClass("fa-eye");

    } else if (passInput.attr("type") == "password") {

      passInput.attr('type', 'text');
      pass_eye.removeClass("fa-eye-slash");
      pass_eye.addClass("fa-eye");

    }

  });

  // checking if password matched on keyup
  [pwd, confirm_pwd].forEach(field => {

    field.addEventListener("keyup", () => {

      validation = validatePassword(pwd.value);

      if (validation.isValid) {

        change_status.innerHTML = validation.strength;
        change_status.style.color = "Gray";
        // check if confirm password matches

        if (pwd?.value == confirm_pwd?.value && pwd?.value) {

          status.innerHTML = "Match";
          status.style.color = "Green";
          password_ok = true;

        } else if (!pwd?.value || !confirm_pwd?.value) {

          status.innerHTML = "";
          password_ok = false;

        } else {

          status.innerHTML = "Did Not Match";
          status.style.color = "Red";
          password_ok = false;

        }

      } else {

        change_status.innerHTML = "";
        change_status.style.color = "Red";

        validation.messages.forEach((message) => {
          change_status.innerHTML += `* ${message}<br/>`;
        });

        password_ok = false;

      }

    })

  });

  function validatePassword(password) {

    const result = {
      isValid: true,
      messages: [],
      strength: 'Weak',
    };

    // Minimum length of 8 characters
    if (password.length < 8) {
      result.isValid = false;
      result.messages.push('Password must be at least 8 characters.');
    }

    // At least one uppercase letter
    if (!/[A-Z]/.test(password)) {
      result.isValid = false;
      result.messages.push('Password must contain at least one uppercase letter.');
    }

    // At least one lowercase letter
    if (!/[a-z]/.test(password)) {
      result.isValid = false;
      result.messages.push('Password must contain at least one lowercase letter.');
    }

    // At least one digit
    if (!/\d/.test(password)) {
      result.isValid = false;
      result.messages.push('Password must contain at least one digit.');
    }

    // At least one special character
    if (!/[!@#$%^&*(),.?":{}|<>]/.test(password)) {
      result.isValid = false;
      result.messages.push('Password must contain at least one special character.');
    }

    // Set password strength level based on criteria met
    if (result.isValid) {
      if (password.length >= 12 && /[!@#$%^&*(),.?":{}|<>]/.test(password)) {
        result.strength = 'Password Strength: Strong';
      } else if (password.length >= 8) {
        result.strength = 'Password Strength: Moderate';
      }
    }

    return result;

  }
</script>