<script>
  let side_btns = document.querySelectorAll(".sidebar-btn");

  $(".accordion-header").on("click", function() {

    if (!$(this).hasClass("collapsed")) {

      let parent_height = $("#sidebar-panel").height();
      let element_offset = $(this).offset().top;

      if (element_offset > parent_height - 100) {

        setTimeout(() => {
          $('#sidebar-panel').animate({
            scrollTop: $('#sidebar-panel').scrollTop() + 200
          }, 300);
        }, 100);

      }

    }

  });

  side_btns.forEach(btn => {

    btn.addEventListener("click", (e) => {

      e.preventDefault();

      $(".side-btn").removeClass("active");
      btn.classList.add("active");

      $('.accordion-collapse').collapse('hide');

      setTimeout(() => {

        let href = btn.getAttribute("href");

        if (href) {
          window.location.href = href;
        }

      }, 150);

    });

  });

  $("#<%=title%>").addClass("active");
  if (document.getElementById("<%= nest %>")) {
    $("#<%= nest %>").addClass("active");
  }

  $.ajax({
    url: '/content/expiry',
    type: 'GET',
    success: (time) => {

      $("#expiry_date").text(time);

    }
  });

  function loadPage(url) {

    let container = $("#load-componenets");

    container.html(TEMPLATE.loader);

    $.get(url, (data) => {

        container.html(data);

      })
      .fail((xhr, status, err) => {

        console.log(err);
        toast("Page loading failed", err.toString(), 1);

      })

  }
</script>