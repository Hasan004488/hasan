<%
let current_page = parseInt(pagination?.curr);
let total_page = parseInt(pagination?.total);
%>

<nav aria-label="Page navigation">

  <ul class="pagination pagination-sm mb-0 justify-content-end">

    <li class="page-item <%= current_page - 1 < 1 ? "disabled" : "" %>">
        <a href="<%= query %>&page=1" class="page-link fw-bold">
            First
        </a>
    </li>
    <li class="page-item <%= current_page - 1 < 1 ? "disabled" : "" %>">
        <a href="<%= query %>&page=<%=current_page - 1%>" 
            class="fw-bold page-link">
            <i class="fa fa-arrow-left"></i>
            Previous
        </a>
    </li>
    <li class="page-item <%= current_page + 1 > total_page ? "disabled" : "" %>">
        <a href="<%= query %>&page=<%=current_page + 1%>" 
            class="fw-bold page-link <%= current_page + 1 > total_page ? "disabled" : "" %>">
            Next
            <i class="fa fa-arrow-right"></i>
        </a>
    </li>
    <li class="page-item <%= current_page + 1 > total_page ? "disabled" : "" %>">
        <a href="<%= query %>&page=<%=total_page%>" class="fw-bold page-link">
            Last
        </a>
    </li>

  </ul>
  
</nav>