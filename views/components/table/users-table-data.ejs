<% data.forEach((user, idx) => { %>
<tr class="slide-in-up">
  <td><%= user?.sid?.toUpperCase() ?? "EU00000" %></td>
  <td>
    <div class="d-flex align-items-center gap-2">
      <div>
        <img src="/content/assets/images/<%= user.profile_image || 'user-profile.png  ' %>" alt="" class="profile_image" style="height: 2.3rem; width: 2.3rem;">
      </div>
      <div>
        <strong><%= user.full_name ?? "Not found" %></strong><br />
        <small><%= user.email ?? "Not found" %></small>
      </div>
    </div>
  </td>
  <td>
    <span title="Permission: <%=role?.permissions || 'Hidden'%>"><i class="fa fa-circle-info"></i></span>
    <span><%= user.role ?? "Not found" %></span>
  </td>
  <td class="text-center <% access("modifyUser", locals.permissions) ? '' : 'area_disabled' %>">

    <% if (user.logged_in === true) { %>

    <button class="toggle-btn bg-success" onclick="updateData('Are you sure to logout this account?', '/dashboard/users/logout', '<%= user.sid %>', 'GET')" title="Force Logout Account">
      Online
      <span class="bg-white inline-circle"></span>
    </button>

    <% } else { %>

    <span class="toggle-btn bg-secondary area-muted">
      <span class="bg-white inline-circle"></span>
      Offline
    </span>

    <% } %>

  </td>
  <td class="text-center <% access("blockUser", locals.permissions) ? '' : 'area_disabled' %>">
    <% if (user.blocked !== true) { %>

    <button class="toggle-btn bg-secondary" onclick="updateData('Are you sure to block this account?', '/dashboard/users/block?type=block', '<%= user.sid %>', 'GET')" title="Block Account">
      <span class="bg-white inline-circle"></span>
      Unblocked
    </button>

    <% } else { %>

    <button class="toggle-btn bg-danger" onclick="updateData(null, '/dashboard/users/block?type=unblock', '<%= user.sid %>', 'GET')" title="UnBlock Account">
      Blocked
      <span class="bg-white inline-circle"></span>
    </button>

    <% } %>
  </td>
  <td>
    <div class="d-flex justify-content-center gap-2 <%= user.role === "Admin" && !access("control", locals.permissions) ? "d-none" : '' %>">

      <% if(access("modifyUser", locals.permissions)) { %>

      <a href="/dashboard/users/edit?id=<%= user.sid %>" class="btn rounded-pill btn-sm btn-success" data-toggle="tooltip" title="Edit This User">
        <i class="fa fa-pen"></i>
        Edit
      </a>

      <% } else { %>

      <a href="#" class="btn rounded-pill btn-sm btn-secondary area-muted" title="You don't have permission to edit user">
        <i class="fa fa-pen"></i>
        Edit
      </a>

      <% } %>

      <% if(access("deleteUser", locals.permissions)) { %>

      <button class="btn rounded-pill btn-sm btn-danger" onclick="deleteUser('<%= user.sid %>')" title="Delete this account permanently">
        <i class="fa fa-trash"></i>
      </button>

      <% } else { %>

      <a href="#" class="btn rounded-pill btn-sm btn-danger area-muted" data-toggle="tooltip" title="You don't have permission to delete user">
        <i class="fa fa-trash"></i>
      </a>

      <% } %>

    </div>
  </td>
</tr>
<tr id="dropdata-<%= idx %>" class="d-none">
  <td colspan="8" class="p-3">
    <div class="bg-white rounded p-3">
      <div class="data"></div>
    </div>
  </td>
</tr>
<% }) %>