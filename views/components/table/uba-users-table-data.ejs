<% if (page < 2) { %>
  <tr id="trow-create-new" class="d-none slide-in-up">
    <td><span class="py-1 px-2 rounded bg-secondary text-white">Automatic</span></td>
    <td class="fw-bold">
      <div class="d-flex align-items-center gap-1">
        <input class="w-100 raw-input fw-bold" name="username" type="text" value="" placeholder="Username">
      </div>
    </td>
    <td>
      <div class="d-flex align-items-center gap-1">
        <input class="w-100 raw-input" name="fullname" type="text" value="" placeholder="Fullname">
      </div>
    </td>
    <td class="text-center">
      <div class="d-flex align-items-center gap-1">
        <select class="w-100 text-center raw-input" name="type">
          <option value="Application User" selected>Application User</option>
          <option value="Admin User">Admin User</option>
          <option value="System User">System User</option>
        </select>
      </div>
    </td>
    <td>
      <div class="d-flex align-items-center justify-content-center gap-1">
  
        <button class="btn rounded-pill btn-sm btn-success px-2" data-toggle="tooltip"
          title="Edit This User" onclick="updateRow(this, '#trow-create-new', 'Are you sure to create a new user?', '/dashboard/uba/users/create', null, 'POST');">
          <span class="spinner-border d-none spinner-border-sm me-2" role="status" aria-hidden="true"></span>
          <i class="fa fa-plus"></i>
          Create
        </button>
        <button class="btn rounded-pill btn-sm btn-secondary"data-toggle="tooltip"
          title="Edit This User" onclick="toggle('#trow-create-new');">
          <i class="fa fa-times"></i>
          Cancel
        </button>
  
      </div>
    </td>
  </tr>   
<% } %>
<% data.forEach((user, idx) => { %>
  <tr id="trow-<%= user._id %>" class="slide-in-up">
    <td><%= user?.sid?.toUpperCase() ?? "none" %></td>
    <td class="fw-bold">
      <div class="d-flex align-items-center gap-1">
        <span class="clickable" onclick="navigator.clipboard.writeText('<%= user?.username %>').then(() => toast('Text Copied!', 'Username copied to clipboard', 1));" title="Copy Username">
          <img src="/images/icons/copy.png" alt="" height="20">
        </span>
        <input class="w-100 clean-input fw-bold" readonly name="username" type="text" value="<%= user?.username ?? "unknown" %>">
      </div>
    </td>
    <td>
      <div class="d-flex align-items-center gap-1">
        <input class="w-100 clean-input" readonly name="fullname" type="text" value="<%= user.fullname ?? "unknown" %>">
      </div>
    </td>
    <td class="text-center">
      <div class="d-flex align-items-center gap-1">
        <input class="w-100 text-center clean-input" readonly name="type" type="text" value="<%= user.type ?? "none" %>">
      </div>
    </td>
    <td>
      <div class="d-flex align-items-center justify-content-center gap-1">

        <% if(access("modifyUser", locals.permissions)) { %>

          <button class="btn rounded-pill btn-sm btn-success px-2" data-toggle="tooltip" 
            title="Edit This User" onclick="editRow(this, '#trow-<%= user._id %>');">
            <i class="fa fa-pen"></i>
            Edit
          </button>
          <button class="d-none btn rounded-pill btn-sm btn-success px-2" data-toggle="tooltip" 
            title="Edit This User" onclick="updateRow(this, '#trow-<%= user._id %>', 'Are you sure to update this user?', '/dashboard/uba/users/update', '<%= user._id %>', 'POST');">
            <span class="spinner-border d-none spinner-border-sm me-2" role="status" aria-hidden="true"></span>            
            <i class="fa fa-check"></i>
            Update
          </button>
          <button class="d-none btn rounded-pill btn-sm btn-secondary" data-toggle="tooltip" 
            title="Edit This User" onclick="editRow(this, '#trow-<%= user._id %>');">
            <i class="fa fa-times"></i>
            Cancel
          </button>

        <% } else { %>

          <button href="#" class="btn rounded-pill btn-sm btn-secondary area-muted px-2"
            title="You don't have permission to edit user">
            <i class="fa fa-pen"></i>
            Edit
          </button>

        <% } %>
          
        <% if(access("deleteUser", locals.permissions)) { %>

            <button class="btn rounded-pill btn-sm btn-danger" 
                onclick="updateData('Are sure to permanently delete this user?', '/dashboard/uba/users/delete', '<%= user._id %>');" title="Permanently delete this user">
                <i class="fa fa-trash"></i>
            </button>

        <% } else { %>

            <a href="#" class="btn rounded-pill btn-sm btn-danger area-muted" data-toggle="tooltip" title="You don't have permission to delete user">
                <i class="fa fa-trash"></i>
            </a>

        <% } %>

      </div>
    </td>
  </tr>
<% }) %>