<% 
let create_ticket_permit = false; 
if(access("createTicket", locals.permissions)) { create_ticket_permit = true } 

const renderBadge = (text, type, block = true) => {
  return `
    <span class="d-${block ? "block" : "inline"} badge bg-${type} rounded-pill">${text}</span>
  `;
}

%>

<% data.forEach((event) => { %> 
  <% 
    let _id = event._id; 
    let view_log_url = `/dashboard/wazuh/logs/data/raw?idfs=id&operators=equal_to&types=string&values=${event.log_id || event.log}`;
    if (event.discovered !== "Wazuh") {
      view_log_url = `/dashboard/surface/logs/data/raw?id=${event._id}`;
    }
  %>
  <tr class="slide-in-up">
      <td class="text-nowrap">
        <%
          let timestamp = event?.date instanceof Date ? event.date : new Date(event?.date);
          let time_part = timestamp?.toLocaleTimeString() || "";
        %>
        <span><%= time_part %></span>
      </td>
      <td class="text-center">
        <%= event?.tenant_id || "Unknown" %>
      </td>
      <td class="">
        <span title="Click to view log preview" class="clickable" onclick="loadDynamicPopup('Detailed Log Preview', '<%=view_log_url%>')">
          <img src="/images/icons/view-log.png" alt="" height="20">
        </span>
        <%= locals.format.truncateText(event.description, 50) ?? "No Description" %>
      </td>
      <td class="text-center">
        <%- renderBadge(event?.agent_id ?? "None", "primary", false) %>
      </td>
      <td class="text-center">
        <% let risk = event?.risk || "No Risk"; %>
        <%- renderBadge(risk, risk === "Low" ? "success" : risk === "High" ? "danger" : "primary") %>
      </td>
      <td class="text-center">
        <% let discovered = event?.discovered || "Unknown"; %>
        <%- renderBadge(discovered, discovered === "Wazuh" ? "info" : "danger") %>
      </td>
      <td class="text-center">
          <% if (create_ticket_permit) { %>

              <a class="badge btn btn-primary rounded-pill mx-2" href="/dashboard/tickets/create?log_id=<%= event.log_id || event.log %>" target="_blank">
                <i class="fa fa-add"></i>
                  Ticket
              </a>
              
          <% } else { %>
            <a class="badge btn btn-primary rounded-pill mx-2 area_disabled" href="#" target="_blank" title="You don't have permission to create ticket">
              <i class="fa fa-add"></i>
                Ticket
            </a>
          <% } %>
      </td>
  </tr>
  <tr id="dropdata-<%= _id %>" class="d-none">
      <td colspan="<%= 8 %>" class="p-3">
        <div class="bg-white rounded p-3">
          <div class="d-md-flex gap-3 mb-3">
            <div class="w-100 rounded shadow p-3 border-start border-primary">
              <div class="fw-bold">Agent</div>
              <div class="fw-bold fs-2 text-primary"><%= event.agent_id || "Unknown" %></div>
            </div>
            <div class="w-100 rounded shadow p-3 border-start border-primary">
              <div class="fw-bold">Rule</div>
              <div class="fw-bold fs-2 text-primary"><%= event.rule_id || "unknown" %></div>
            </div>
            <div class="w-100 rounded shadow p-3 border-start border-primary">
              <div class="fw-bold">Firedtimes</div>
              <div class="fw-bold fs-2 text-primary"><%= event.firedtimes|| "0" %></div>
            </div>
            <div class="w-100 rounded shadow p-3 border-start border-primary">
              <div class="fw-bold">Severity</div>
              <div class="fw-bold fs-2 text-danger"><%= event.severity || "0" %></div>
            </div>
          </div>
        </div>
      </td>
  </tr>
<% }) %>