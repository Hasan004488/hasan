<% for(i = 0; i < data?.length; i++) { %>
  <tr class="slide-in-up">
      <td class="text-center">
          <div class="btn-group">
              <a href="/dashboard/tickets/info?id=<%= data[i]?.sid %>" target="_blank" 
                  class="btn btn-sm btn-primary rounded-pill">
                  <i class="fa fa-external-link"></i>
                  View
              </a>
          </div>
      </td>
      <td class="text-nowrap">
          <%= data[i]?.opening?.toLocaleTimeString() || "" %> <br>
          <span class="small"><%= data[i]?.opening?.toLocaleDateString() || "" %></span>
      </td>
      <td>
          <%= data[i]?.sid?.toUpperCase() ?? "unknown" %>
      </td>
      <td>
          <%= data[i]?.title ?? "Not found" %>
      </td>
      <td class="text-center">
          <span class="badge bg-secondary rounded-pill">
              <%= data[i]?.phase ?? "0" %>
          </span>
      </td>
      <td class="text-center">
          <%= data[i]?.type ?? "Unknown" %>
      </td>
      <td class="text-center">
          <%= data[i]?.criticality ?? "Unknown" %>
      </td>
      <td class="text-center">
        <div class="d-flex justify-content-center gap-2">

            <% if (!access("modifyTicket", locals.permissions)) { %>

                <!-- no permission -->
                <button type="button" class="toggle-btn bg-secondary area_disabled" data-bs-toggle="popover" data-bs-placement="top" data-bs-content="You don't have permission to modify Status">
                    <span class="bg-white inline-circle"></span>
                    <%= data[i]?.status || "Unknown" %>
                </button>
             
            <% } else { %>

                <% if (data[i]?.status == "open" && access("modifyTicket", locals.permissions)) { %>
    
                    <button class="toggle-btn bg-primary" onclick="updateData('Are you sure to close this ticket?', '/dashboard/tickets/close', '<%= data[i].sid %>')">
                      Open
                      <span class="bg-white inline-circle"></span>
                    </button>
          
                <% } else { %>
          
                    <button class="toggle-btn bg-secondary" onclick="updateData('Are you sure to re-open this ticket?', '/dashboard/tickets/open', '<%= data[i].sid %>')">
                      <span class="bg-white inline-circle"></span>
                      <%= data[i]?.status || "Unknown" %>
                    </button>
          
                <% } %>
    
                <% if (access("admin", locals.permissions)) { %>
    
                    <button class="btn badge rounded-pill btn-danger" onclick="updateData('Are you sure to permanently delete this ticket?', '/dashboard/tickets/delete', '<%= data[i].sid %>', 'GET')">
                        <i class="fa fa-trash"></i>
                    </button>
    
                <% } %>

            <% } %>
            
        </div>
      </td>
  </tr>
  <% } %>